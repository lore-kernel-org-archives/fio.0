-static int server_post_init(struct thread_data *td)
-{
-	struct librpma_fio_server_data *csd = td->io_ops_data;
-	struct server_data *sd = csd->server_data;
-	size_t io_us_size;
-	size_t io_u_buflen;
-	int ret;
