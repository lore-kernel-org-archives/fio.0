+
+# See beginning of main() for how bin_vals are computed
+bin_vals =3D []
+lower_bin_vals =3D [] # lower edge of each bin
+upper_bin_vals =3D [] # upper edge of each bin
+
+def process_interval(ctx, iHist, iEnd):
