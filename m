> >  tools/fiologparser.py           |  6 +++++-
> >  tools/hist/fiologparser_hist.py | 17 +++++++++++------
> >  unit_tests/steadystate_tests.py | 21 ++++++++++++---------
> >  4 files changed, 31 insertions(+), 16 deletions(-)
> >
> > diff --git a/doc/conf.py b/doc/conf.py
> > index d4dd9d20..087a9a11 100644
> > --- a/doc/conf.py
> > +++ b/doc/conf.py
> > @@ -22,6 +22,9 @@
> >
